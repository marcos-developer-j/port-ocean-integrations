# Port credentials (obtener en app.getport.io -> ... -> Credentials)
PORT_CLIENT_ID=your_port_client_id
PORT_CLIENT_SECRET=your_port_client_secret
PORT_BASE_URL=https://api.us.getport.io

# Confluence Cloud credentials
# Base URL: https://<tu-sitio>.atlassian.net
OCEAN__INTEGRATION__CONFIG__CONFLUENCE_BASE_URL=https://tuempresa.atlassian.net
# Usuario: email de tu cuenta Atlassian
OCEAN__INTEGRATION__CONFIG__CONFLUENCE_USERNAME=tu-email@empresa.com
# API Token: crear en https://id.atlassian.com/manage-profile/security/api-tokens
OCEAN__INTEGRATION__CONFIG__CONFLUENCE_API_TOKEN=your_atlassian_api_token

# Opcional: tamaño de página para paginación
OCEAN__INTEGRATION__CONFIG__PAGE_SIZE=50
